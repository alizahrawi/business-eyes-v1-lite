{
  "name": "business-eyes-v1-lite",
  "version": "1.0.0",
  "description": "Business Eyes product suite monorepo, beginning with an AI-powered Telegram daily report builder.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @business-eyes/daily-report-builder",
    "build": "npm run build --workspace @business-eyes/daily-report-builder",
    "start": "npm run start --workspace @business-eyes/daily-report-builder",
    "lint": "npm run lint --workspace @business-eyes/daily-report-builder",
    "test": "npm run test --workspace @business-eyes/daily-report-builder",
    "typecheck": "npm run typecheck --workspace @business-eyes/daily-report-builder",
    "db:generate": "npm run db:generate --workspace @business-eyes/daily-report-builder"
  }
}
